# Raspberry Pi / FastAPI
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Gemini is optional: leave blank for deterministic local Edge fallback.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=auto
USE_GEMINI=true

# PostgreSQL on the Raspberry Pi; do not commit actual credentials.
TIGER_DB_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/courier_edge_db
USE_TIGER=true

# Real-road routing; Rumbo automatically falls back to a local estimate if unavailable.
OSRM_URL=https://router.project-osrm.org
USE_OSRM=true

# Monterrey reference and accelerated demo clock.
MONTERREY_LAT=25.6866
MONTERREY_LON=-100.3161
TICK_MS=500
