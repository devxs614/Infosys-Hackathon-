APP_ENV=development
HOST=0.0.0.0
PORT=8000

GEMINI_API_KEY=
# `auto` discovers a currently available text Gemini model through the SDK.
GEMINI_MODEL=auto
# Keep the real password only in .env, never in this tracked template.
TIGER_DB_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/courier_edge_db

OSRM_URL=https://router.project-osrm.org
SHIFT_MINUTES=240
DEMO_SECONDS=180
TICK_MS=500
USE_OSRM=true
USE_TIGER=true
USE_GEMINI=true
MONTERREY_LAT=25.6866
MONTERREY_LON=-100.3161
SCENARIO_SEED=42
